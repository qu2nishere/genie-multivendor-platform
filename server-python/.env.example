# AI Worker (server-python) — chép thành server-python/.env (bị .gitignore chặn). docs/cau-hinh-moi-truong.md mục AI Worker.
INTERNAL_TOKEN=local-internal-token          # TRÙNG genie.security.internal-token của backend
BACKEND_URL=http://localhost:8080            # chỉ gọi lại đúng địa chỉ này (bỏ qua host trong callback_url)
MODELS_DIR=models                            # face_detection_yunet_2023mar.onnx, face_recognition_sface_2021dec.onnx
STORAGE_ALLOWED_HOSTS=localhost:9000         # host được tải ảnh KYC; prod: *.s3.ap-southeast-1.amazonaws.com
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
# Ngưỡng KYC (cấu hình — không ghi cứng)
KYC_FACE_MATCH_THRESHOLD=0.363
KYC_FACE_LOW_THRESHOLD=0.25
KYC_LIVENESS_THRESHOLD=0.5
KYC_MIN_IMAGE_SIDE=600
KYC_BLUR_THRESHOLD=60
KYC_DOWNLOAD_MAX_BYTES=12582912
KYC_DOWNLOAD_TIMEOUT_S=5
KYC_MAX_CONCURRENCY=1
KYC_PIPELINE_TIMEOUT_S=20
CALLBACK_RETRIES=3
