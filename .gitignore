# =====================================================================
#  .gitignore — monorepo genie-platform
#  (server-spring · server-python · web · deploy · scripts)
#  Nguyên tắc (TECH_STACK mục 2.2): KHÔNG commit .env, khóa bí mật,
#  mô hình *.onnx, dump CSDL, node_modules/, target/, .venv/
# =====================================================================

# ---------------------------------------------------------------------
# 1. Bí mật & biến môi trường
# ---------------------------------------------------------------------
.env
.env.*
*.env
!.env.example
!**/.env.example
*.pem
*.key
*.crt
*.p12
*.pfx
*.jks
*.keystore
id_rsa*
id_ed25519*
secrets/
credentials.json
service-account*.json
# Chứng chỉ Let's Encrypt nếu lỡ sao chép về repo
letsencrypt/
certs/

# ---------------------------------------------------------------------
# 2. Dữ liệu, sao lưu, mô hình AI
# ---------------------------------------------------------------------
# Mô hình — tải bằng scripts/fetch-models.sh
*.onnx
*.pt
*.pth
*.bin
*.safetensors
server-python/models/*
!server-python/models/.gitkeep
# Dump / sao lưu CSDL & MinIO
*.dump
*.sql.gz
*.backup
backup/data/
/backup/
# Dữ liệu volume Docker nếu bind-mount trong repo
pgdata/
redisdata/
miniodata/
*.rdb
appendonly.aof
appendonlydir/

# ---------------------------------------------------------------------
# 3. Backend — Java / Maven (server-spring)
# ---------------------------------------------------------------------
target/
.flattened-pom.xml
pom.xml.tag
pom.xml.releaseBackup
pom.xml.versionsBackup
pom.xml.next
release.properties
dependency-reduced-pom.xml
buildNumber.properties
.mvn/timing.properties
.mvn/wrapper/maven-wrapper.jar
*.class
hs_err_pid*
replay_pid*
# Log file của logback-spring.xml
logs/
*.log

# ---------------------------------------------------------------------
# 4. Frontend — Node / Astro (web, công cụ gốc)
# ---------------------------------------------------------------------
node_modules/
dist/
.astro/
.cache/
.npm/
.eslintcache
.stylelintcache
*.tsbuildinfo
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-store/
# Kiểm thử
coverage/
playwright-report/
test-results/
blob-report/
playwright/.cache/
.vitest/

# ---------------------------------------------------------------------
# 5. AI Worker — Python (server-python)
# ---------------------------------------------------------------------
.venv/
venv/
env/
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
pip-wheel-metadata/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
.coverage.*
htmlcov/
.ipynb_checkpoints/

# ---------------------------------------------------------------------
# 6. IDE & công cụ
# ---------------------------------------------------------------------
# IntelliJ / PyCharm / DataGrip
.idea/
*.iml
*.iws
*.ipr
out/
# VS Code — giữ lại cấu hình dùng chung nếu nhóm muốn
.vscode/*
!.vscode/extensions.json
!.vscode/settings.shared.json
# Eclipse / STS / NetBeans
.classpath
.project
.settings/
.factorypath
.apt_generated/
.sts4-cache/
nbproject/private/
nbbuild/
nbdist/
# Claude Code — cấu hình cá nhân
.claude/settings.local.json
# Vim / Emacs
*.swp
*.swo
*~
\#*\#

# ---------------------------------------------------------------------
# 7. Hệ điều hành
# ---------------------------------------------------------------------
.DS_Store
._*
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# ---------------------------------------------------------------------
# 8. Tạm thời
# ---------------------------------------------------------------------
tmp/
temp/
*.tmp
*.bak
*.orig
*.rej
