---
// Khung khu Tài khoản (prototype Account.jsx): menu trái 232px + vùng nội dung; màn hẹp xếp 1 cột,
// menu thành hàng cuộn ngang. Nội dung từng mục là island riêng đặt vào slot.
import AccountNav from './AccountNav';
import type { AccountSection } from '../domain/account.menu';

interface Props {
  active: AccountSection;
  /** Tên trang — <h1> duy nhất (R18), ẩn khỏi mắt vì mỗi khối đã có tiêu đề nhìn thấy. */
  title: string;
}
const { active, title } = Astro.props;
---

<div
  class="mx-auto max-w-[1280px] px-6 pt-[22px] pb-14 grid grid-cols-[232px_minmax(0,1fr)] gap-6 items-start max-md:grid-cols-1 max-md:gap-3 max-md:px-3"
>
  <h1 class="sr-only">{title}</h1>
  <AccountNav client:load active={active} />
  <div class="flex flex-col gap-[18px] min-w-0">
    <slot />
  </div>
</div>
