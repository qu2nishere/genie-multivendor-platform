---
// Khung trang storefront (plan G07.04, G07.06; TS 2.4): SEO + Open Graph, theme, nhãn bỏ qua,
// nền trời, Header (island client:load), <main id="main">, Footer (SSR tĩnh), toast.
import SeoHead from './partials/SeoHead.astro';
import ThemeBoot from './partials/ThemeBoot.astro';
import Footer from './storefront/Footer.astro';
import Header from './storefront/Header';
import ToastHost from './storefront/ToastHost';
import { buildTree, listCategories } from '@/features/catalog';
import { LOGGED_IN_COOKIE } from '@/shared/auth/session';
import { createT } from '@/shared/lib/i18n';
import type { JsonLd } from '@/shared/lib/seo';
import '@/styles/global.css';

interface Props {
  title: string;
  description?: string;
  canonical?: string;
  image?: string;
  imageAlt?: string;
  noindex?: boolean;
  follow?: boolean;
  type?: 'website' | 'product' | 'article';
  jsonLd?: JsonLd[];
  /**
   * Biến thể lớp gốc (prototype index.html): bar = có thanh mua dính đáy (sản phẩm, checkout);
   * cart = thanh tổng giỏ; task = trang tác vụ (ẩn hàng danh mục ở màn hẹp).
   */
  variant?: 'bar' | 'cart';
  task?: boolean;
  /** Trang chủ: nền trời cao theo hero (tr-main--home). */
  home?: boolean;
  /** Chữ đang tìm (giữ lại trong ô tìm kiếm trên trang /search). */
  query?: string;
}

const { variant, task = false, home = false, query, ...seo } = Astro.props;
// Hàng danh mục header: SSR lấy cây danh mục (gốc + con cho ngăn kéo màn hẹp)
const categories = buildTree(await listCategories()).map((c) => ({
  slug: c.slug,
  name: c.name,
  icon: c.icon,
  children: c.children.map((s) => ({ slug: s.slug, name: s.name })),
}));
const loggedInHint = Astro.cookies.has(LOGGED_IN_COOKIE);
const path = Astro.url.pathname + Astro.url.search;
const lang = Astro.locals.lang ?? 'vi';
const t = createT(lang);
const rootClass = ['tr-root', variant && `tr-root--${variant}`, task && 'tr-root--task']
  .filter(Boolean)
  .join(' ');
---

<!doctype html>
<html lang={lang}>
  <head>
    <SeoHead {...seo} />
    <ThemeBoot />
  </head>
  <body class="tr">
    <a class="tr-skip" href="#main">{t('common.label.skip_to_content')}</a>
    <div class={rootClass}>
      <div class="tr-sky" aria-hidden="true"></div>
      <Header
        client:load
        categories={categories}
        loggedInHint={loggedInHint}
        path={path}
        initialQuery={query}
      />
      <main id="main" tabindex="-1" class:list={['tr-main', home && 'tr-main--home']}>
        <slot />
      </main>
      <Footer />
      <slot name="overlays" />
    </div>
    <ToastHost client:idle />
  </body>
</html>
