---
// Khung trang đăng nhập / đăng ký / quên mật khẩu (plan G07.08; prototype auth Panel):
// cột thương hiệu (lời hứa + 3 cam kết) và cột form 480px; màn hẹp ẩn cột thương hiệu.
import SeoHead from './partials/SeoHead.astro';
import ThemeBoot from './partials/ThemeBoot.astro';
import ToastHost from './storefront/ToastHost';
import { createT } from '@/shared/lib/i18n';
import { GenieLogo } from '@/shared/ui/brand';
import { Icon } from '@/shared/ui/icon/Icon';
import '@/styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const { title, description } = Astro.props;
const lang = Astro.locals.lang ?? 'vi';
const t = createT(lang);
const promises = [
  { icon: 'shield-check', key: 'hold' },
  { icon: 'undo-2', key: 'return' },
  { icon: 'truck', key: 'freeship' },
] as const;
---

<!doctype html>
<html lang={lang}>
  <head>
    <SeoHead title={title} description={description} noindex />
    <ThemeBoot />
  </head>
  <body class="tr gn-auth">
    <a class="tr-skip" href="#main">{t('common.label.skip_to_content')}</a>
    <div class="min-h-screen grid grid-cols-1 md:grid-cols-[1fr_480px]">
      <aside class="gn-auth__brand hidden md:flex" aria-label={t('layout.auth.brand_label')}>
        <a href="/" class="no-underline" aria-label={t('layout.header.home')}>
          <GenieLogo size={40} tone="light" />
        </a>
        <div class="gn-auth__copy">
          <p class="gn-auth__title" role="presentation">
            {t('layout.auth.promise_1')}<br />{t('layout.auth.promise_2')}
          </p>
          <p>{t('layout.auth.lead')}</p>
          <ul>
            {
              promises.map((p) => (
                <li>
                  <Icon name={p.icon} size={20} />
                  <span>
                    <b>{t(`layout.auth.${p.key}.title`)}</b>
                    {t(`layout.auth.${p.key}.text`)}
                  </span>
                </li>
              ))
            }
          </ul>
        </div>
      </aside>
      <main
        id="main"
        tabindex="-1"
        class="relative flex flex-col justify-center bg-surface-card px-4 py-6 md:px-12 md:py-10"
      >
        <div class="absolute top-3 right-4 flex items-center gap-1.5">
          <slot name="tools" />
        </div>
        <a
          href="/"
          class="md:hidden mb-6 self-start no-underline"
          aria-label={t('layout.header.home')}
        >
          <GenieLogo size={34} />
        </a>
        <slot />
      </main>
    </div>
    <ToastHost client:idle />
  </body>
</html>
