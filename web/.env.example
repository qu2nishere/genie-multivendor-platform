# Biến môi trường của web (Astro) — TECH_STACK mục 2.4, 16.6
# Địa chỉ công khai của web (canonical, sitemap, Open Graph)
PUBLIC_WEB_URL=http://localhost:4321
# API gọi từ trình duyệt
PUBLIC_API_URL=http://localhost:8080/api/v1
# API gọi nội bộ khi SSR (trong docker: http://backend:8080/api/v1)
INTERNAL_API_URL=http://localhost:8080/api/v1
# Ảnh / tệp trên MinIO
PUBLIC_S3_URL=http://localhost:9000
# true = mọi *.api.ts trả dữ liệu mock (chưa có backend — plan quyết định D3)
PUBLIC_USE_MOCK=true
