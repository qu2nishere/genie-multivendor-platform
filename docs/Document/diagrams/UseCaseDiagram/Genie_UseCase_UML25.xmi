        <packagedElement xmi:type="uml:UseCase" xmi:id="EAID_8C85F60B_70D3_5853_B665_0F3BAD1D61F0" name="UC-LOG-03: Đồng bộ hành trình giao nhận qua Webhook GHN" visibility="public" subject="EAID_5E9C1042_75CA_56D9_9953_4F17EDDCEC7C">
          <ownedComment xmi:type="uml:Comment" xmi:id="EAID_817B191D_F9C6_5BAB_B28F_2D50A339D1B5" body="UC-LOG-03 — Đồng bộ hành trình giao nhận qua Webhook GHN. Trạng thái: Chưa triển khai — xử lý phía máy chủ (cron / webhook / AI), giao diện chỉ hiển thị kết quả trên mock. Tác nhân chính: Đối tác vận chuyển (GHN, GHTK, ViettelPost, J&amp;T) [ACT-3PL]. Tác nhân phụ: Finance Officer (Nhân viên tài chính) [ACT-FIN]; Payment Gateway (VNPay, SePay) [ACT-PGW]."/>
        </packagedElement>
        <packagedElement xmi:type="uml:UseCase" xmi:id="EAID_203C256C_3B6C_5F77_8CE2_3AC1A341A2CD" name="UC-LOG-15: Điều phối đa hãng vận chuyển (Dynamic Carrier Routing)" visibility="public" subject="EAID_5E9C1042_75CA_56D9_9953_4F17EDDCEC7C">
          <ownedComment xmi:type="uml:Comment" xmi:id="EAID_56736999_966A_5602_80E6_A09BE4ADA425" body="UC-LOG-15 — Điều phối đa hãng vận chuyển (Dynamic Carrier Routing). Trạng thái: Chưa triển khai — xử lý phía máy chủ (cron / webhook / AI), giao diện chỉ hiển thị kết quả trên mock. Tác nhân chính: —. Tác nhân phụ: Đối tác vận chuyển (GHN, GHTK, ViettelPost, J&amp;T) [ACT-3PL]."/>
        </packagedElement>
        <packagedElement xmi:type="uml:UseCase" xmi:id="EAID_F8946F36_1206_5550_9077_2C6B986B238C" name="UC-LOG-16: Người bán xác nhận / từ chối đơn hàng mới" visibility="public" subject="EAID_5E9C1042_75CA_56D9_9953_4F17EDDCEC7C">
