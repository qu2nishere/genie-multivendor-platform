        <packagedElement xmi:type="uml:UseCase" xmi:id="EAID_1ACCF115_6BEC_5D52_9527_0AB050D7A8FD" name="UC-ORD-11: Khách hàng xác nhận &quot;Đã nhận hàng thành công&quot;" visibility="public" subject="EAID_A682479A_37C3_57EE_B0B0_3232C51CBAF5">
