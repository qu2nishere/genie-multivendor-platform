<?xml version="1.0" encoding="UTF-8"?>
<xmi:XMI xmi:version="2.1" xmlns:uml="http://schema.omg.org/spec/UML/2.1" xmlns:xmi="http://schema.omg.org/spec/XMI/2.1" xmlns:thecustomprofile="http://www.sparxsystems.com/profiles/thecustomprofile/1.0">
  <xmi:Documentation exporter="Enterprise Architect" exporterVersion="6.5"/>
  <uml:Model xmi:type="uml:Model" name="EA_Model" visibility="public">
    <packagedElement xmi:type="uml:Package" xmi:id="EAPK_0FB9CC82_6B77_54B9_AB2A_7F31690FB254" name="Genie TLCN — Mô hình Use Case (UML 2.5)" visibility="public">
      <ownedComment xmi:type="uml:Comment" xmi:id="EAID_CED697EC_64BB_57BA_9F2A_7614C1EAF7F6" body="Sinh tự động từ TLCN/diagrams/UseCaseDiagram/Usecase.md (TLCN v1.3 — use case giữ nguyên như v1.2; v1.3 chỉ đổi mô hình dữ liệu &amp; đường dẫn API) — 87 use case, 11 phân hệ, 16 tác nhân, 4 use case dùng chung. Cùng nguồn với UML_UseCase_PlantUML.md."/>
      <packagedElement xmi:type="uml:Package" xmi:id="EAPK_FBCB786D_E7FA_53B5_805D_2D47C955930E" name="00. Tác nhân" visibility="public">
        <packagedElement xmi:type="uml:Package" xmi:id="EAPK_3A4D3C08_B2FB_5096_A39C_625AAAC59E22" name="Con người &amp; chức danh nhân viên" visibility="public">
          <packagedElement xmi:type="uml:Actor" xmi:id="EAID_9DED7606_7839_56A0_B897_B950ECF6059C" name="Guest (khách vãng lai)" visibility="public">
            <ownedComment xmi:type="uml:Comment" xmi:id="EAID_6CBA466E_0C9C_506D_8BD2_FEA0AB18D8B0" body="Mã: ACT-GST. Người chưa đăng nhập. Xem danh mục, tìm kiếm (từ khóa gợi ý), xem chi tiết sản phẩm, sản phẩm tương tự, trang shop, đánh giá; mở link chia sẻ sản phẩm; thêm vào giỏ tạm (lưu trình duyệt); đăng ký tài khoản hoặc đăng nhập Google / Apple."/>
          </packagedElement>
          <packagedElement xmi:type="uml:Actor" xmi:id="EAID_EA99B4B1_096D_54CC_A6F2_A5BAD0368351" name="Customer (khách hàng)" visibility="public">
            <ownedComment xmi:type="uml:Comment" xmi:id="EAID_26347749_967E_52FF_859F_D9E86A52C354" body="Mã: ACT-CUS. Đã đăng ký và kích hoạt tài khoản. Quản lý hồ sơ, sổ địa chỉ, giỏ hàng; đặt hàng nhiều shop trong 1 lần, thanh toán VNPay / VietQR (SePay) / COD; lưu và xếp chồng voucher 3 tầng, dùng Điểm; mua Flash Sale; theo dõi đơn, xác nhận đã nhận, đánh giá, bấm Hữu ích, báo cáo đánh giá; chat, theo dõi shop; yêu cầu trả hàng / hoàn tiền; xóa tài khoản."/>
            <generalization xmi:type="uml:Generalization" xmi:id="EAID_10A769D9_2751_59DD_9CFB_317CF53F235C" general="EAID_9DED7606_7839_56A0_B897_B950ECF6059C"/>
          </packagedElement>
          <packagedElement xmi:type="uml:Actor" xmi:id="EAID_3CC15B11_A7E5_5488_9BD1_9F6A58DAF93C" name="Vendor (người bán/shop)" visibility="public">
            <ownedComment xmi:type="uml:Comment" xmi:id="EAID_8BE136DC_901A_5017_952E_4432479B327A" body="Mã: ACT-VND. Khách hàng đã mở shop và được duyệt KYC (cùng 1 tài khoản, có thêm chế độ Bán). Quản lý sản phẩm / SKU / giấy tờ chứng thực, đề xuất danh mục, xác nhận và xử lý đơn, voucher shop, đăng ký Flash Sale, phản hồi và báo cáo đánh giá, chat (trả lời tự động), cài đặt gian hàng / vận chuyển / tạm nghỉ, ví &amp; sổ giao dịch, tài khoản nhận tiền và rút tiền."/>
            <generalization xmi:type="uml:Generalization" xmi:id="EAID_281D5D30_EA41_57A0_8EF0_1280FF945D90" general="EAID_EA99B4B1_096D_54CC_A6F2_A5BAD0368351"/>
          </packagedElement>
          <packagedElement xmi:type="uml:Actor" xmi:id="EAID_C0F33D54_B3C4_5292_AC27_C262889B326A" name="Staff (Nhân viên sàn)" visibility="public">
            <ownedComment xmi:type="uml:Comment" xmi:id="EAID_4D2A51D6_2908_5A0E_B138_CCC72B29A423" body="Mã: ACT-STF. Nhân viên vận hành sàn (role STAFF). Tác nhân tổng quát của 3 chức danh MOD / CS / FIN — quyền thật do Admin cấp theo từng mã quyền (UC-ADM-02). Dùng chung các use case tài khoản (đăng nhập, đổi mật khẩu, thông báo)."/>
          </packagedElement>
          <packagedElement xmi:type="uml:Actor" xmi:id="EAID_8F6DE83B_F275_5D4C_8807_40CE4D392881" name="Moderator (Nhân viên kiểm duyệt)" visibility="public">
            <ownedComment xmi:type="uml:Comment" xmi:id="EAID_D63AE011_214E_577B_8643_51F6B6D6AD89" body="Mã: ACT-MOD. Chức danh MODERATOR: duyệt KYC, duyệt sản phẩm (kết quả Gemini), quản lý danh mục và duyệt đề xuất danh mục, kiểm duyệt đánh giá."/>
            <generalization xmi:type="uml:Generalization" xmi:id="EAID_34E767AC_531A_530E_B9B0_F2DC744E2560" general="EAID_C0F33D54_B3C4_5292_AC27_C262889B326A"/>
          </packagedElement>
          <packagedElement xmi:type="uml:Actor" xmi:id="EAID_616EB7A4_62B8_58C1_A137_AA0AC7C2AED6" name="CS Specialist (Nhân viên CSKH)" visibility="public">
            <ownedComment xmi:type="uml:Comment" xmi:id="EAID_B119FCB0_9907_5265_ACE3_53461E9BA105" body="Mã: ACT-CS. Chức danh CS_SPECIALIST: phân xử tranh chấp trả hàng / hoàn tiền, thực hiện hoàn tiền, kiểm duyệt đánh giá."/>
            <generalization xmi:type="uml:Generalization" xmi:id="EAID_C8E2B05D_2E3A_5B48_9C2E_494C1F7CB974" general="EAID_C0F33D54_B3C4_5292_AC27_C262889B326A"/>
          </packagedElement>
          <packagedElement xmi:type="uml:Actor" xmi:id="EAID_7D8D9E39_1D60_52EA_A2AF_8923F9885D51" name="Finance Officer (Nhân viên tài chính)" visibility="public">
            <ownedComment xmi:type="uml:Comment" xmi:id="EAID_AA44319E_C30E_5368_98FA_6F869E60AD3A" body="Mã: ACT-FIN. Chức danh FINANCE_OFFICER: duyệt và chi lệnh rút tiền, cấu hình hoa hồng, xem sổ cái và dashboard tài chính, quản lý voucher sàn và chiến dịch Flash Sale."/>
            <generalization xmi:type="uml:Generalization" xmi:id="EAID_952A4B03_45DC_51B1_B59D_AFD78E6FB6C6" general="EAID_C0F33D54_B3C4_5292_AC27_C262889B326A"/>
          </packagedElement>
          <packagedElement xmi:type="uml:Actor" xmi:id="EAID_E002D21B_BF6C_57E1_AC19_FCBBB6E9C3C6" name="Admin" visibility="public">
            <ownedComment xmi:type="uml:Comment" xmi:id="EAID_171A8DA9_03BF_5921_BF73_0884D44B12C8" body="Mã: ACT-ADM. Quản trị viên cao nhất (không có Super Admin). Mọi quyền của nhân viên, cộng thêm: quản lý nhân viên &amp; phân quyền, khóa / mở khóa người dùng, nhật ký hệ thống, thông báo toàn sàn, banner trang chủ."/>
            <generalization xmi:type="uml:Generalization" xmi:id="EAID_E21F58EF_DE80_5854_BB78_D612B8BAAA69" general="EAID_C0F33D54_B3C4_5292_AC27_C262889B326A"/>
          </packagedElement>
        </packagedElement>
        <packagedElement xmi:type="uml:Package" xmi:id="EAPK_E73BFCE4_BB62_536D_9CD8_D8F8BE5A65D0" name="Hệ thống" visibility="public">
          <packagedElement xmi:type="uml:Actor" xmi:id="EAID_E6BD241F_0F1F_5B45_8A65_0B7C94562F49" name="Payment Gateway (VNPay, SePay)" visibility="public">
            <ownedComment xmi:type="uml:Comment" xmi:id="EAID_610F2AFB_66FC_5236_A026_B2FAC7D2C906" body="Mã: ACT-PGW. VNPay (sandbox khi demo): chuyển hướng thanh toán thẻ / QR, IPN HMAC-SHA512, API hoàn tiền. SePay: theo dõi biến động tài khoản ngân hàng của sàn, gửi webhook khi có tiền vào (khách chuyển khoản VietQR, GHN chuyển tiền COD) và tiền ra (xác nhận lệnh rút tiền / hoàn tiền nhân viên chuyển tay); SePay không tự chi tiền."/>
          </packagedElement>
          <packagedElement xmi:type="uml:Actor" xmi:id="EAID_A96B8EA1_ECCD_59E8_AE21_B9D0148D5741" name="Đối tác vận chuyển (GHN, GHTK, ViettelPost, J&amp;T)" visibility="public">
            <ownedComment xmi:type="uml:Comment" xmi:id="EAID_86F20BF3_1EFB_5333_9D62_DAD6BDC3BFEC" body="Mã: ACT-3PL. GHN là hãng mặc định: API địa giới, tính phí, tạo vận đơn, in phiếu gửi, webhook hành trình, thu hộ COD và đối soát. GHTK / ViettelPost / J&amp;T Express dùng cùng giao thức qua lớp adapter khi shop bật hãng đó (UC-LOG-15)."/>
          </packagedElement>
          <packagedElement xmi:type="uml:Actor" xmi:id="EAID_E4CECCCD_86F0_5E45_ADF0_46AD0E686AE3" name="AI Worker Service (KYC &amp; PhoBERT)" visibility="public">
            <ownedComment xmi:type="uml:Comment" xmi:id="EAID_8981B0CB_3BD5_5C6C_A257_2ABA6E83AD4D" body="Mã: ACT-AIW. Dịch vụ Python FastAPI chạy riêng, chỉ phục vụ KYC: giải mã QR CCCD, đọc MRZ, phát hiện quốc huy / vân tay, so khớp khuôn mặt (ONNX) và chấm điểm rủi ro."/>
          </packagedElement>
          <packagedElement xmi:type="uml:Actor" xmi:id="EAID_00B938EF_D39B_5177_A808_8F158AC46ED3" name="Google Gemini API" visibility="public">
            <ownedComment xmi:type="uml:Comment" xmi:id="EAID_C24EDE10_A36D_57DB_9386_D3062C56DAF8" body="Mã: ACT-GEM. Mô hình ngôn ngữ lớn của Google gọi qua REST API (structured output JSON). Dùng cho kiểm duyệt sản phẩm tự động (UC-CAT-12): nhận tên, mô tả, danh mục, ảnh sản phẩm; trả quyết định APPROVE / REJECT / NEED_REVIEW, điểm rủi ro và lý do."/>
          </packagedElement>
          <packagedElement xmi:type="uml:Actor" xmi:id="EAID_BC9C6FD8_560E_59A2_8F57_F2D84D836952" name="Identity Provider (Google, Apple)" visibility="public">
            <ownedComment xmi:type="uml:Comment" xmi:id="EAID_7E130C2E_23DF_539C_AF76_F995334136AD" body="Mã: ACT-IDP. Nhà cung cấp danh tính OAuth2 / OpenID Connect cho đăng nhập mạng xã hội (UC-AUTH-03)."/>
          </packagedElement>
          <packagedElement xmi:type="uml:Actor" xmi:id="EAID_5943FC68_FF6F_55AF_A6A5_F2EA9860A921" name="Silo S3 Storage" visibility="public">
            <ownedComment xmi:type="uml:Comment" xmi:id="EAID_A316A91E_5A8B_57F2_A791_DC5B82B9FCB2" body="Mã: ACT-MIN. Lưu trữ đối tượng tương thích S3: ảnh sản phẩm / mô tả / đánh giá, ảnh đại diện, logo và ảnh bìa shop, banner, hồ sơ KYC và giấy tờ chứng thực sản phẩm (bucket riêng tư), bằng chứng trả hàng; cấp Presigned URL. Trong sơ đồ: nối với use case dùng chung «Tải tệp lên Silo (Presigned URL)»."/>
          </packagedElement>
          <packagedElement xmi:type="uml:Actor" xmi:id="EAID_41AB068C_CEB7_58CB_9E7F_2EC3F833787C" name="Email Service" visibility="public">
            <ownedComment xmi:type="uml:Comment" xmi:id="EAID_5EA529D1_63B8_5383_B27B_498F70000CC2" body="Mã: ACT-EML. Dịch vụ SMTP (Gmail SMTP / Mailtrap khi demo) gửi OTP, lời mời kích hoạt nhân viên, cảnh báo đăng nhập và email giao dịch. Trong sơ đồ: nối với use case dùng chung «Gửi mã OTP xác thực» và trực tiếp với các use case gửi email."/>
          </packagedElement>
          <packagedElement xmi:type="uml:Actor" xmi:id="EAID_EE75B949_3608_548C_92D3_608CDFEE0BE4" name="Platform Cron / Scheduler" visibility="public">
            <ownedComment xmi:type="uml:Comment" xmi:id="EAID_F9433235_E4F3_5309_8756_0C660783BEED" body="Mã: ACT-CRN. Tác vụ định kỳ của Spring (@Scheduled): hủy đơn quá hạn thanh toán, tự hoàn tất đơn sau 7 ngày, giải ngân ký quỹ, mở / đóng Flash Sale, hết hạn Điểm, ẩn danh hóa tài khoản sau 30 ngày, tổng hợp lượt xem / từ khóa, tính chỉ số shop."/>
          </packagedElement>
        </packagedElement>
      </packagedElement>
      <packagedElement xmi:type="uml:Package" xmi:id="EAPK_521ADAE3_8CC1_56C4_8A87_C6CADCA72C98" name="01. Xác thực &amp; Tài khoản người dùng" visibility="public">
        <packagedElement xmi:type="uml:Component" xmi:id="EAID_5F0062B3_8384_50A6_85D7_8D88C628FA21" name="Xác thực &amp; Tài khoản người dùng" visibility="public"/>
        <packagedElement xmi:type="uml:UseCase" xmi:id="EAID_809FAF01_1E1E_5B3A_87B3_DBF51ED2BE5D" name="UC-AUTH-01: Đăng ký tài khoản Khách hàng" visibility="public" subject="EAID_5F0062B3_8384_50A6_85D7_8D88C628FA21">
          <ownedComment xmi:type="uml:Comment" xmi:id="EAID_D561830C_869F_5F48_9895_90D9B405B6CA" body="UC-AUTH-01 — Đăng ký tài khoản Khách hàng. Trạng thái: Đã triển khai — backend + test, web nối API thật, đã chạy thật. Tác nhân chính: Guest (khách vãng lai) [ACT-GST]. Tác nhân phụ: —."/>
          <include xmi:type="uml:Include" xmi:id="EAID_D59AB5ED_3D37_536F_9001_C2BF10092841" addition="EAID_88C362BF_CF64_5F5E_ADED_2056EC10DD75"/>
        </packagedElement>
        <packagedElement xmi:type="uml:UseCase" xmi:id="EAID_E014A49B_E562_50AC_A6E4_ED67F44906C2" name="UC-AUTH-02: Đăng nhập hệ thống" visibility="public" subject="EAID_5F0062B3_8384_50A6_85D7_8D88C628FA21">
          <ownedComment xmi:type="uml:Comment" xmi:id="EAID_D5661D99_D117_5035_A7C6_B3C5C1F830BE" body="UC-AUTH-02 — Đăng nhập hệ thống. Trạng thái: Đã triển khai — backend + test, web nối API thật (còn GET /me). Tác nhân chính: Customer (khách hàng) [ACT-CUS]; Vendor (người bán/shop) [ACT-VND]; Staff (Nhân viên sàn) [ACT-STF]; Admin [ACT-ADM]. Tác nhân phụ: —."/>
          <extensionPoint xmi:type="uml:ExtensionPoint" xmi:id="EAID_E066EBF0_23F1_5D17_ACE5_7FDF2151DCC0" name="Chọn đăng nhập mạng xã hội" visibility="public"/>
          <include xmi:type="uml:Include" xmi:id="EAID_9467C351_B61A_5EBF_9A17_2C29D14593B5" addition="EAID_5DE1CAAA_A699_5E42_9745_C040442519A2"/>
        </packagedElement>
        <packagedElement xmi:type="uml:UseCase" xmi:id="EAID_8EE83D19_2926_566A_929E_4B77FAA1C8EC" name="UC-AUTH-03: Đăng nhập &amp; Liên kết tài khoản Google / Apple (OAuth2 / OpenID Connect)" visibility="public" subject="EAID_5F0062B3_8384_50A6_85D7_8D88C628FA21">
          <ownedComment xmi:type="uml:Comment" xmi:id="EAID_BE13AC7B_ADD2_5AF6_A727_5AB0F73132B9" body="UC-AUTH-03 — Đăng nhập &amp; Liên kết tài khoản Google / Apple (OAuth2 / OpenID Connect). Trạng thái: Đang triển khai — Google xong (đăng nhập, liên kết / gỡ liên kết), Apple chưa làm. Tác nhân chính: Guest (khách vãng lai) [ACT-GST]; Customer (khách hàng) [ACT-CUS]. Tác nhân phụ: Identity Provider (Google, Apple) [ACT-IDP]."/>
          <extend xmi:type="uml:Extend" xmi:id="EAID_02228012_E6E0_50C7_92C3_60B20CE17B59" extendedCase="EAID_E014A49B_E562_50AC_A6E4_ED67F44906C2" extensionLocation="EAID_E066EBF0_23F1_5D17_ACE5_7FDF2151DCC0">
            <condition xmi:type="uml:Constraint" xmi:id="EAID_C8659362_E23E_5DED_825A_94D8D1DBB172" name="người dùng bấm “Đăng nhập với Google / Apple”">
              <specification xmi:type="uml:OpaqueExpression" xmi:id="EAID_1EF2A0CD_B152_5A22_93BB_5784AF141FA9" body="người dùng bấm “Đăng nhập với Google / Apple”"/>
            </condition>
          </extend>
        </packagedElement>
        <packagedElement xmi:type="uml:UseCase" xmi:id="EAID_1F95305B_EDED_5E57_B868_8D83A8AA246C" name="UC-AUTH-04: Khôi phục mật khẩu qua Email OTP (Forgot Password)" visibility="public" subject="EAID_5F0062B3_8384_50A6_85D7_8D88C628FA21">
          <ownedComment xmi:type="uml:Comment" xmi:id="EAID_4C1F8B74_2925_5C5E_80BA_5E67EC744A4B" body="UC-AUTH-04 — Khôi phục mật khẩu qua Email OTP (Forgot Password). Trạng thái: Đã triển khai — backend + test, web nối API thật, đã chạy thật. Tác nhân chính: Customer (khách hàng) [ACT-CUS]; Vendor (người bán/shop) [ACT-VND]; Staff (Nhân viên sàn) [ACT-STF]. Tác nhân phụ: —."/>
          <include xmi:type="uml:Include" xmi:id="EAID_F4463093_1F41_547F_95DA_75D9D6D6FC4A" addition="EAID_88C362BF_CF64_5F5E_ADED_2056EC10DD75"/>
        </packagedElement>
        <packagedElement xmi:type="uml:UseCase" xmi:id="EAID_25F13FF1_05CC_50CE_9E25_913E32148FCC" name="UC-AUTH-06: Đổi / Thiết lập mật khẩu" visibility="public" subject="EAID_5F0062B3_8384_50A6_85D7_8D88C628FA21">
          <ownedComment xmi:type="uml:Comment" xmi:id="EAID_6110975C_A085_5415_B9A3_F5F7CBA1EBD7" body="UC-AUTH-06 — Đổi / Thiết lập mật khẩu. Trạng thái: Đang triển khai — backend + test + web nối xong, chưa chạy thật. Tác nhân chính: Customer (khách hàng) [ACT-CUS]; Vendor (người bán/shop) [ACT-VND]; Staff (Nhân viên sàn) [ACT-STF]; Admin [ACT-ADM]. Tác nhân phụ: —."/>
          <include xmi:type="uml:Include" xmi:id="EAID_E20ED6F4_EE53_566F_B42B_CC4492DCDECC" addition="EAID_88C362BF_CF64_5F5E_ADED_2056EC10DD75"/>
        </packagedElement>
        <packagedElement xmi:type="uml:UseCase" xmi:id="EAID_FED0433F_1A70_5212_B2BB_030AF1FA75F3" name="UC-AUTH-08: Quản lý thông tin hồ sơ cá nhân (Customer Profile)" visibility="public" subject="EAID_5F0062B3_8384_50A6_85D7_8D88C628FA21">
          <ownedComment xmi:type="uml:Comment" xmi:id="EAID_F545E211_2BDB_5B28_A395_163C47794EAF" body="UC-AUTH-08 — Quản lý thông tin hồ sơ cá nhân (Customer Profile). Trạng thái: Đang triển khai — hồ sơ + ảnh đại diện (Silo) xong; còn GET /me, đổi email. Tác nhân chính: Customer (khách hàng) [ACT-CUS]; Staff (Nhân viên sàn) [ACT-STF]. Tác nhân phụ: —."/>
          <include xmi:type="uml:Include" xmi:id="EAID_A6F74185_32C4_5D18_863D_ECFA654CC795" addition="EAID_7FAE9990_00E4_5A86_AA97_4F96A4CE4963"/>
        </packagedElement>
        <packagedElement xmi:type="uml:UseCase" xmi:id="EAID_69D17448_68D7_5348_9267_8268F0A0B13C" name="UC-AUTH-09: Quản lý sổ địa chỉ giao hàng chuẩn GHN" visibility="public" subject="EAID_5F0062B3_8384_50A6_85D7_8D88C628FA21">
          <ownedComment xmi:type="uml:Comment" xmi:id="EAID_50CA88F3_C9CC_581C_AC72_4BBC421F634B" body="UC-AUTH-09 — Quản lý sổ địa chỉ giao hàng chuẩn GHN. Trạng thái: Chưa triển khai backend — giao diện đã dựng trên lớp mock. Tác nhân chính: Customer (khách hàng) [ACT-CUS]. Tác nhân phụ: Đối tác vận chuyển (GHN, GHTK, ViettelPost, J&amp;T) [ACT-3PL]."/>
        </packagedElement>
        <packagedElement xmi:type="uml:UseCase" xmi:id="EAID_1F45BF37_C4BF_586F_A410_3E6C312979B5" name="UC-AUTH-10: Yêu cầu ẩn danh hóa &amp; Xóa dữ liệu cá nhân (Xóa tài khoản)" visibility="public" subject="EAID_5F0062B3_8384_50A6_85D7_8D88C628FA21">
          <ownedComment xmi:type="uml:Comment" xmi:id="EAID_F5506F3C_B9F7_5880_A730_41A2A3AE6CDE" body="UC-AUTH-10 — Yêu cầu ẩn danh hóa &amp; Xóa dữ liệu cá nhân (Xóa tài khoản). Trạng thái: Đang triển khai — backend + test + web nối xong, chưa chạy thật; cổng chặn của order / payment chưa cài. Tác nhân chính: Customer (khách hàng) [ACT-CUS]. Tác nhân phụ: Platform Cron / Scheduler [ACT-CRN]."/>
          <include xmi:type="uml:Include" xmi:id="EAID_E6813F3C_21C0_5666_9D29_72453D20B791" addition="EAID_88C362BF_CF64_5F5E_ADED_2056EC10DD75"/>
        </packagedElement>
        <packagedElement xmi:type="uml:UseCase" xmi:id="EAID_ADEFC183_986B_5CB0_863C_7475924F3824" name="UC-AUTH-11: Đăng xuất &amp; Quản lý thiết bị đăng nhập" visibility="public" subject="EAID_5F0062B3_8384_50A6_85D7_8D88C628FA21">
          <ownedComment xmi:type="uml:Comment" xmi:id="EAID_03C8F96C_D1EB_5B46_B105_85654D7E58DE" body="UC-AUTH-11 — Đăng xuất &amp; Quản lý thiết bị đăng nhập. Trạng thái: Đang triển khai — backend + test + web nối xong, chưa chạy thật. Tác nhân chính: Customer (khách hàng) [ACT-CUS]; Vendor (người bán/shop) [ACT-VND]; Staff (Nhân viên sàn) [ACT-STF]; Admin [ACT-ADM]. Tác nhân phụ: —."/>
        </packagedElement>
        <packagedElement xmi:type="uml:UseCase" xmi:id="EAID_88C362BF_CF64_5F5E_ADED_2056EC10DD75" name="Gửi mã OTP xác thực" visibility="public" subject="EAID_5F0062B3_8384_50A6_85D7_8D88C628FA21">
          <ownedComment xmi:type="uml:Comment" xmi:id="EAID_F0F5001E_DFE8_5DD6_811B_93F192D695B2" body="Gửi mã OTP xác thực — use case dùng chung (không mã), được «include» bởi UC-AUTH-01, UC-AUTH-04, UC-AUTH-06, UC-AUTH-10, UC-VND-01, UC-ADM-01."/>
        </packagedElement>
        <packagedElement xmi:type="uml:UseCase" xmi:id="EAID_5DE1CAAA_A699_5E42_9745_C040442519A2" name="Ghi nhật ký kiểm toán" visibility="public" subject="EAID_5F0062B3_8384_50A6_85D7_8D88C628FA21">
          <ownedComment xmi:type="uml:Comment" xmi:id="EAID_E82BC7E2_1F5F_50CC_845A_12DB5381B6D0" body="Ghi nhật ký kiểm toán — use case dùng chung (không mã), được «include» bởi UC-AUTH-02, UC-ADM-01, UC-ADM-02, UC-ADM-03, UC-SOC-05."/>
        </packagedElement>
        <packagedElement xmi:type="uml:UseCase" xmi:id="EAID_7FAE9990_00E4_5A86_AA97_4F96A4CE4963" name="Tải tệp lên Silo (Presigned URL)" visibility="public" subject="EAID_5F0062B3_8384_50A6_85D7_8D88C628FA21">
          <ownedComment xmi:type="uml:Comment" xmi:id="EAID_3D28D46B_56EA_54AD_B0E5_94FB087B2B30" body="Tải tệp lên Silo (Presigned URL) — use case dùng chung (không mã), được «include» bởi UC-AUTH-08, UC-CAT-09, UC-CAT-10, UC-VND-02, UC-VND-21, UC-SOC-02, UC-SOC-03, UC-SUP-01, UC-NOT-05, UC-ADM-12."/>
