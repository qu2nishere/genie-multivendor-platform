        <packagedElement xmi:type="uml:UseCase" xmi:id="EAID_17495E7E_27AB_5C43_A497_6088BA69C6ED" name="UC-SOC-02: Gửi thẻ sản phẩm, hình ảnh và trạng thái đơn hàng trong chat" visibility="public" subject="EAID_EA0237C6_2429_57B9_B7A0_AFB13400124B">
          <ownedComment xmi:type="uml:Comment" xmi:id="EAID_02FE5367_710E_5571_A679_C031D3148E7D" body="UC-SOC-02 — Gửi thẻ sản phẩm, hình ảnh và trạng thái đơn hàng trong chat. Trạng thái: Chưa triển khai backend — giao diện đã dựng trên lớp mock. Tác nhân chính: Customer (khách hàng) [ACT-CUS]; Vendor (người bán/shop) [ACT-VND]. Tác nhân phụ: Silo S3 Storage [ACT-MIN]."/>
