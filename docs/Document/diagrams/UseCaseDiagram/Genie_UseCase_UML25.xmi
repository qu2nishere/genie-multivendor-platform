        <packagedElement xmi:type="uml:UseCase" xmi:id="EAID_83B75EA0_F671_54F3_A46A_8E99BD6615A0" name="UC-NOT-01: Thông báo trong ứng dụng thời gian thực (WebSocket)" visibility="public" subject="EAID_0CDF8370_F41B_54D8_8D53_3257627E85CD">
