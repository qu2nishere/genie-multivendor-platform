        <packagedElement xmi:type="uml:UseCase" xmi:id="EAID_FC12F657_ECF0_5D47_9EF0_51C2AAD74978" name="UC-SOC-01: Nhắn tin trò chuyện thời gian thực Khách - Shop (Live Chat)" visibility="public" subject="EAID_EA0237C6_2429_57B9_B7A0_AFB13400124B">
          <ownedComment xmi:type="uml:Comment" xmi:id="EAID_BB4993E2_1B9A_5BDB_AD8D_BD133E0FAEB1" body="UC-SOC-01 — Nhắn tin trò chuyện thời gian thực Khách - Shop (Live Chat). Trạng thái: Chưa triển khai backend — giao diện đã dựng trên lớp mock. Tác nhân chính: Customer (khách hàng) [ACT-CUS]; Vendor (người bán/shop) [ACT-VND]. Tác nhân phụ: —."/>
          <extensionPoint xmi:type="uml:ExtensionPoint" xmi:id="EAID_F6249F43_E4AB_50AF_B21F_405692DB16F8" name="Gửi tin nhắn" visibility="public"/>
