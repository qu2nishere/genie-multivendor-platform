        <packagedElement xmi:type="uml:UseCase" xmi:id="EAID_EF14741C_CC97_587E_BD85_A4039C7B5321" name="UC-NOT-03: Gửi email giao dịch tự động" visibility="public" subject="EAID_0CDF8370_F41B_54D8_8D53_3257627E85CD">
