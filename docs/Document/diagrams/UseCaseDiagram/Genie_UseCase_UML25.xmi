      <packagedElement xmi:type="uml:Package" xmi:id="EAPK_EFBE8C0E_D351_5DBF_96CB_48A2439DD8D5" name="03. Giỏ hàng, Đặt hàng &amp; Đơn hàng" visibility="public">
        <packagedElement xmi:type="uml:Component" xmi:id="EAID_A682479A_37C3_57EE_B0B0_3232C51CBAF5" name="Giỏ hàng, Đặt hàng &amp; Đơn hàng" visibility="public"/>
        <packagedElement xmi:type="uml:UseCase" xmi:id="EAID_FC2F6975_372D_5979_B022_C98CB3830FEA" name="UC-ORD-01: Quản lý giỏ hàng mua sắm cá nhân (Shopping Cart)" visibility="public" subject="EAID_A682479A_37C3_57EE_B0B0_3232C51CBAF5">
          <ownedComment xmi:type="uml:Comment" xmi:id="EAID_30E8148F_1F3F_5F77_A064_F073051A9992" body="UC-ORD-01 — Quản lý giỏ hàng mua sắm cá nhân (Shopping Cart). Trạng thái: Chưa triển khai backend — giao diện đã dựng trên lớp mock. Tác nhân chính: Guest (khách vãng lai) [ACT-GST]; Customer (khách hàng) [ACT-CUS]. Tác nhân phụ: —."/>
        </packagedElement>
        <packagedElement xmi:type="uml:UseCase" xmi:id="EAID_D8BE25F1_DC37_5D24_8EB7_351EE18A0EB4" name="UC-ORD-04: Xem trước đơn hàng &amp; Tách giỏ hàng đa nhà bán (Cart Preview &amp; Splitting)" visibility="public" subject="EAID_A682479A_37C3_57EE_B0B0_3232C51CBAF5">
          <ownedComment xmi:type="uml:Comment" xmi:id="EAID_6A52BB0E_3195_5E1C_8247_D362FE9B7C05" body="UC-ORD-04 — Xem trước đơn hàng &amp; Tách giỏ hàng đa nhà bán (Cart Preview &amp; Splitting). Trạng thái: Chưa triển khai backend — giao diện đã dựng trên lớp mock. Tác nhân chính: Customer (khách hàng) [ACT-CUS]. Tác nhân phụ: Đối tác vận chuyển (GHN, GHTK, ViettelPost, J&amp;T) [ACT-3PL]."/>
          <extensionPoint xmi:type="uml:ExtensionPoint" xmi:id="EAID_7CBD3571_A94F_5A01_BF1F_EF269EC3B66D" name="Chọn voucher" visibility="public"/>
          <include xmi:type="uml:Include" xmi:id="EAID_FEB8825B_DE2E_5F0D_A001_5AD7E83B3417" addition="EAID_DD131BA6_72F7_5667_BDBE_BCB78FF0DB94"/>
        </packagedElement>
        <packagedElement xmi:type="uml:UseCase" xmi:id="EAID_DD131BA6_72F7_5667_BDBE_BCB78FF0DB94" name="UC-ORD-06: Tính phí vận chuyển qua GHN API" visibility="public" subject="EAID_A682479A_37C3_57EE_B0B0_3232C51CBAF5">
          <ownedComment xmi:type="uml:Comment" xmi:id="EAID_BA4E7D9A_8CEC_5067_ABA4_1DE5DC220824" body="UC-ORD-06 — Tính phí vận chuyển qua GHN API. Trạng thái: Chưa triển khai backend — giao diện đã dựng trên lớp mock. Tác nhân chính: —. Tác nhân phụ: Đối tác vận chuyển (GHN, GHTK, ViettelPost, J&amp;T) [ACT-3PL]."/>
        </packagedElement>
        <packagedElement xmi:type="uml:UseCase" xmi:id="EAID_82344970_DB5E_5D24_827F_AAE3CCF03CA4" name="UC-ORD-07: Tạo phiên Checkout &amp; Các Đơn hàng con theo Shop (PersistCheckout)" visibility="public" subject="EAID_A682479A_37C3_57EE_B0B0_3232C51CBAF5">
          <ownedComment xmi:type="uml:Comment" xmi:id="EAID_553A2E10_E8E0_53D0_A7C1_940A06EDAA56" body="UC-ORD-07 — Tạo phiên Checkout &amp; Các Đơn hàng con theo Shop (PersistCheckout). Trạng thái: Chưa triển khai backend — giao diện đã dựng trên lớp mock. Tác nhân chính: Customer (khách hàng) [ACT-CUS]. Tác nhân phụ: —."/>
          <extensionPoint xmi:type="uml:ExtensionPoint" xmi:id="EAID_6FBD4BD0_E248_5EAC_A3BA_AA25FD2ACFAD" name="Giữ chỗ tồn kho" visibility="public"/>
          <include xmi:type="uml:Include" xmi:id="EAID_2EFD1CF4_8C0D_5053_92F0_C001BBBF44AD" addition="EAID_D8BE25F1_DC37_5D24_8EB7_351EE18A0EB4"/>
        </packagedElement>
        <packagedElement xmi:type="uml:UseCase" xmi:id="EAID_EA442AF1_1085_531E_AB11_10B8B5504D84" name="UC-ORD-08: Tự động hủy đơn quá hạn thanh toán &amp; Hoàn kho (Sweeper Cron)" visibility="public" subject="EAID_A682479A_37C3_57EE_B0B0_3232C51CBAF5">
          <ownedComment xmi:type="uml:Comment" xmi:id="EAID_F0F128C9_7BE8_5546_AD2B_53A7F498C392" body="UC-ORD-08 — Tự động hủy đơn quá hạn thanh toán &amp; Hoàn kho (Sweeper Cron). Trạng thái: Chưa triển khai — xử lý phía máy chủ (cron / webhook / AI), giao diện chỉ hiển thị kết quả trên mock. Tác nhân chính: Platform Cron / Scheduler [ACT-CRN]. Tác nhân phụ: —."/>
        </packagedElement>
        <packagedElement xmi:type="uml:UseCase" xmi:id="EAID_B7302E37_AA03_59FE_898D_0A37D0C489F3" name="UC-ORD-09: Khách hàng theo dõi chi tiết hành trình đơn hàng" visibility="public" subject="EAID_A682479A_37C3_57EE_B0B0_3232C51CBAF5">
          <ownedComment xmi:type="uml:Comment" xmi:id="EAID_977223E0_0440_5DEF_AA74_2C4ECCFABB40" body="UC-ORD-09 — Khách hàng theo dõi chi tiết hành trình đơn hàng. Trạng thái: Chưa triển khai backend — giao diện đã dựng trên lớp mock. Tác nhân chính: Customer (khách hàng) [ACT-CUS]. Tác nhân phụ: Đối tác vận chuyển (GHN, GHTK, ViettelPost, J&amp;T) [ACT-3PL]."/>
        </packagedElement>
        <packagedElement xmi:type="uml:UseCase" xmi:id="EAID_9DA6842A_FA4F_5DAB_A163_5BA0BF7D3757" name="UC-ORD-10: Khách hàng yêu cầu hủy đơn hàng" visibility="public" subject="EAID_A682479A_37C3_57EE_B0B0_3232C51CBAF5">
          <ownedComment xmi:type="uml:Comment" xmi:id="EAID_14E7E7D9_6FEB_51B1_8007_2871A5D28B3F" body="UC-ORD-10 — Khách hàng yêu cầu hủy đơn hàng. Trạng thái: Chưa triển khai backend — giao diện đã dựng trên lớp mock. Tác nhân chính: Customer (khách hàng) [ACT-CUS]. Tác nhân phụ: Payment Gateway (VNPay, SePay) [ACT-PGW]."/>
