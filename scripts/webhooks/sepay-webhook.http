### Giả lập webhook SePay biến động số dư (chuyển khoản VietQR nội dung TR{paymentId})
@api = http://localhost:8080/api/v1
@sepayKey = local-sepay-api-key

POST {{api}}/payments/sepay/webhook
Authorization: Apikey {{sepayKey}}
Content-Type: application/json

{
  "id": 100001,
  "gateway": "MBBank",
  "transactionDate": "2026-06-08 10:15:00",
  "accountNumber": "0000000000",
  "content": "TR12 thanh toan don hang",
  "transferType": "in",
  "transferAmount": 250000,
  "referenceCode": "FT26160000001"
}
