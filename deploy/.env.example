# Mọi biến cần có, giá trị GIẢ — TECH_STACK mục 16.6
# Trên VPS: cp .env.example .env && chmod 600 .env

# ---------- Chung ----------
TAG=v0.1.0
GHCR_OWNER=genie
SPRING_PROFILES_ACTIVE=prod
PUBLIC_WEB_URL=https://genie.vn
PUBLIC_API_URL=https://api.genie.vn
INTERNAL_API_URL=http://backend:8080
PUBLIC_S3_URL=https://s3.genie.vn

# ---------- CSDL / Redis / MinIO ----------
DB_URL=jdbc:postgresql://postgres:5432/genie
DB_USER=genie
DB_PASSWORD=changeme
REDIS_PASSWORD=changeme
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=changeme
MINIO_APP_ACCESS_KEY=genie-app
MINIO_APP_SECRET_KEY=changeme

# ---------- Bảo mật ----------
JWT_SECRET=change-me-to-a-random-256-bit-secret
KYC_AES_KEY=change-me-base64-32-bytes
INTERNAL_TOKEN=change-me
WALLET_HMAC_SECRET=change-me
BOOTSTRAP_ADMIN_EMAIL=admin@genie.vn
# Băm Argon2id; trong file .env phải viết mỗi dấu $ thành $$ (Compose nội suy biến)
BOOTSTRAP_ADMIN_PASSWORD_HASH=change-me-argon2id-hash

# ---------- Thanh toán ----------
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_RETURN_URL=https://genie.vn/checkout/result
SEPAY_API_KEY=
SEPAY_ACCOUNT_NUMBER=

# ---------- Vận chuyển ----------
GHN_TOKEN=
GHN_SHOP_ID=
GHTK_TOKEN=
VTP_TOKEN=
JT_KEY=

# ---------- AI / danh tính / mail ----------
GEMINI_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=no-reply@genie.vn
