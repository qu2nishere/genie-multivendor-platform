# Production — mọi biến cần có, giá trị GIẢ (TECH_STACK mục 16.6, ADR 0010)
# CSDL = AWS RDS (PostgreSQL 16), kho tệp = AWS S3. Tạo hạ tầng AWS trước: deploy/aws/README.md
# Trên VPS / EC2: cp .env.example .env && chmod 600 .env  — rồi ĐỔI mọi giá trị change-me / <…>

# ---------- Chung ----------
TAG=v0.1.0
GHCR_OWNER=genie
SPRING_PROFILES_ACTIVE=prod
PUBLIC_WEB_URL=https://genie.vn
PUBLIC_API_URL=https://api.genie.vn
INTERNAL_API_URL=http://backend:8080

# ---------- CSDL — AWS RDS PostgreSQL 16 ----------
# Endpoint lấy ở RDS console → Connectivity & security. Bắt buộc sslmode=require.
DB_URL=jdbc:postgresql://<db-id>.<mã>.ap-southeast-1.rds.amazonaws.com:5432/genie?sslmode=require
DB_USER=genie
DB_PASSWORD=change-me
# Số kết nối tối đa của backend (mặc định 20 ở profile prod; db.t4g.micro ~80 kết nối)
#DB_POOL_SIZE=20
# Dữ liệu mẫu — production LUÔN false
GENIE_SEED_DEMO=false

# ---------- Kho tệp — AWS S3 ----------
# Tên biến MINIO_* giữ nguyên dù dùng AWS S3 (ADR 0009, 0010). Khóa là IAM user chỉ có quyền trên bucket Genie
# (deploy/aws/iam-policy.json) — KHÔNG dùng khóa root của tài khoản AWS.
STORAGE_REGION=ap-southeast-1
MINIO_ENDPOINT=https://s3.ap-southeast-1.amazonaws.com
PUBLIC_S3_URL=https://s3.ap-southeast-1.amazonaws.com
# Tên bucket thật = tiền tố + tên logic (genie-prod-avatar-assets…). Tên bucket S3 là duy nhất toàn cầu — đổi
# tiền tố nếu bị trùng; phải khớp tham số của deploy/aws/s3-init.sh
STORAGE_BUCKET_PREFIX=genie-prod-
MINIO_APP_ACCESS_KEY=<IAM access key id>
MINIO_APP_SECRET_KEY=<IAM secret access key>

# ---------- Redis (container trong Compose) ----------
REDIS_PASSWORD=change-me

# ---------- Bảo mật ----------
JWT_SECRET=change-me-to-a-random-256-bit-secret
KYC_AES_KEY=change-me-base64-32-bytes
INTERNAL_TOKEN=change-me
WALLET_HMAC_SECRET=change-me
# Trộn vào bản băm OTP / token tạm trong Redis (plan AUTH A04.08)
OTP_PEPPER=change-me
# Cookie refresh token genie_rt: true khi chạy HTTPS
AUTH_COOKIE_SECURE=true
# Origin web được gọi API kèm cookie (nhiều origin cách nhau dấu phẩy)
CORS_ALLOWED_ORIGINS=https://genie.vn,https://www.genie.vn
BOOTSTRAP_ADMIN_EMAIL=admin@genie.vn
# Băm Argon2id — sinh bằng: python3 scripts/hash-password.py '<mật khẩu>'
# Trong file .env phải viết mỗi dấu $ thành $$ (Compose nội suy biến)
BOOTSTRAP_ADMIN_PASSWORD_HASH=change-me-argon2id-hash

# ---------- Thanh toán ----------
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_RETURN_URL=https://genie.vn/checkout/result
SEPAY_API_KEY=
SEPAY_ACCOUNT_NUMBER=

# ---------- Vận chuyển ----------
GHN_TOKEN=
GHN_SHOP_ID=
GHTK_TOKEN=
VTP_TOKEN=
JT_KEY=

# ---------- AI / danh tính / mail ----------
GEMINI_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Đăng nhập Zalo (developers.zalo.me) — Callback URL: https://<domain>/auth/oauth-callback
ZALO_APP_ID=
ZALO_APP_SECRET=
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=no-reply@genie.vn

# ---------- Vận hành (tùy chọn) ----------
#LOG_LEVEL_ROOT=INFO
#LOG_LEVEL_GENIE=INFO
#GENIE_SCHEDULING_ENABLED=true
# Dữ liệu mẫu R__seed_demo.sql — để false trên VPS thật, true trên máy demo
GENIE_SEED_DEMO=false
