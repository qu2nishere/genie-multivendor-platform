# Biến môi trường dùng chung cho máy dev — bản đầy đủ cho VPS: deploy/.env.example (TECH_STACK mục 16.6)
SPRING_PROFILES_ACTIVE=local
PUBLIC_WEB_URL=http://localhost:4321
PUBLIC_API_URL=http://localhost:8080
INTERNAL_API_URL=http://localhost:8080
PUBLIC_S3_URL=http://localhost:9000

DB_URL=jdbc:postgresql://localhost:5432/genie
DB_USER=genie
DB_PASSWORD=changeme
REDIS_PASSWORD=changeme
MINIO_ROOT_USER=siloadmin
MINIO_ROOT_PASSWORD=changeme
MINIO_APP_ACCESS_KEY=genie-app
MINIO_APP_SECRET_KEY=changeme

JWT_SECRET=change-me-to-a-random-256-bit-secret
KYC_AES_KEY=change-me
INTERNAL_TOKEN=change-me
WALLET_HMAC_SECRET=change-me
OTP_PEPPER=change-me
AUTH_COOKIE_SECURE=false
CORS_ALLOWED_ORIGINS=http://localhost:4321

# Đăng nhập Google (Google Cloud → Google Auth Platform → Clients; redirect URI http://localhost:4321/auth/oauth-callback)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Đăng nhập Zalo (developers.zalo.me → ứng dụng → Thông tin ứng dụng: ID ứng dụng + Khóa bí mật;
# Đăng nhập → Callback URL http://localhost:4321/auth/oauth-callback)
ZALO_APP_ID=
ZALO_APP_SECRET=

# Gửi email thật bằng Gmail (bỏ trống = gửi vào Mailpit http://localhost:8025). SMTP_PASSWORD là App Password 16 ký tự
# của Gmail (Tài khoản Google → Bảo mật → Mật khẩu ứng dụng), KHÔNG phải mật khẩu đăng nhập Gmail.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_AUTH=true
SMTP_STARTTLS=true
MAIL_FROM=
