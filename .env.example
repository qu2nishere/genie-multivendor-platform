# Biến môi trường dùng chung cho máy dev — bản đầy đủ cho VPS: deploy/.env.example (TECH_STACK mục 16.6)
SPRING_PROFILES_ACTIVE=local
PUBLIC_WEB_URL=http://localhost:4321
PUBLIC_API_URL=http://localhost:8080
INTERNAL_API_URL=http://localhost:8080
PUBLIC_S3_URL=http://localhost:9000

DB_URL=jdbc:postgresql://localhost:5432/genie
DB_USER=genie
DB_PASSWORD=changeme
REDIS_PASSWORD=changeme
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=changeme
MINIO_APP_ACCESS_KEY=genie-app
MINIO_APP_SECRET_KEY=changeme

JWT_SECRET=change-me-to-a-random-256-bit-secret
KYC_AES_KEY=change-me
INTERNAL_TOKEN=change-me
WALLET_HMAC_SECRET=change-me
