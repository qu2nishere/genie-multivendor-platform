# =====================================================================================================================
# .env — biến môi trường máy dev (TECH_STACK mục 16.6). Bản cho VPS: deploy/.env.example. Web: web/.env.example
#
#   cp .env.example .env        → rồi chỉ điền / bỏ comment dòng cần đổi
#
# - Backend tự đọc tệp .env ở gốc repo khi chạy từ IntelliJ / ./mvnw (common/config/DotEnvEnvironmentPostProcessor).
#   Biến môi trường thật / Run Configuration vẫn ghi đè được.
# - Dòng để trống giá trị hoặc bị comment → backend dùng mặc định dev trong application-local.yml
#   (khớp deploy/docker-compose.local.yml). Vì vậy hầu hết dòng dưới đây để comment là chạy được.
# - .env bị .gitignore chặn: được phép ghi mật khẩu thật ở đây, KHÔNG ghi vào application*.yml.
# - Trùng tên biến: dòng viết SAU thắng.
# =====================================================================================================================

# ---------- Profile ----------
# Có 3 profile: local (máy dev — có mặc định cho mọi thứ) · prod (VPS — docker-compose.yml tự đặt) · test (test tự bật).
# Máy dev để nguyên local; không cần đặt profile trong IntelliJ. Chi tiết: docs/cau-hinh-moi-truong.md mục 3.
SPRING_PROFILES_ACTIVE=local

# ---------- CSDL PostgreSQL máy dev — chỉ bật MỘT khối, comment khối còn lại ----------
# Production (AWS RDS) KHÔNG khai ở đây mà ở deploy/.env — đừng trỏ máy dev vào CSDL production.
# [1] Docker: deploy/docker-compose.local.yml (mặc định — để comment cả khối cũng chạy)
DB_URL=jdbc:postgresql://localhost:5432/genie
DB_USER=genie
DB_PASSWORD=changeme

# [2] PostgreSQL cài thẳng trên máy (không qua Docker). Nếu chạy song song với Docker thì cho một bên cổng 5433.
#     Tạo DB trước: CREATE DATABASE genie;
#DB_URL=jdbc:postgresql://localhost:5433/genie
#DB_USER=postgres
#DB_PASSWORD=<mật khẩu lúc cài PostgreSQL>

# Tùy chọn chung cho CSDL
#DB_POOL_SIZE=20                 # số kết nối tối đa (HikariCP)
#GENIE_SEED_DEMO=true            # nạp dữ liệu mẫu R__seed_demo.sql + db/seed (mặc định true ở profile local)
#FLYWAY_ENABLED=true             # false = không chạy migration (chỉ dùng khi DB đã đúng schema)

# ---------- Cổng Docker local (deploy/docker-compose.local.yml) — chỉ đổi khi cổng bị chiếm ----------
# Chạy compose bằng: docker compose --env-file .env -f deploy/docker-compose.local.yml up -d
# Đổi cổng nào thì sửa biến backend tương ứng: POSTGRES_PORT → DB_URL · SILO_PORT → MINIO_ENDPOINT, PUBLIC_S3_URL
# · MAILPIT_SMTP_PORT → SMTP_PORT · REDIS_PORT backend dùng chung. Chi tiết: docs/cau-hinh-moi-truong.md mục 4
#POSTGRES_PORT=5432
#SILO_PORT=9000
#SILO_CONSOLE_PORT=9001
#MAILPIT_SMTP_PORT=1025
#MAILPIT_UI_PORT=8025

# ---------- Redis ----------
#REDIS_HOST=localhost
#REDIS_PORT=6379                # cũng là cổng Docker của Redis
#REDIS_PASSWORD=changeme

# ---------- Silo — kho tệp S3 (tên biến MINIO_* giữ nguyên, ADR 0009) ----------
#MINIO_ENDPOINT=http://localhost:9000          # backend gọi Silo
#PUBLIC_S3_URL=http://localhost:9000           # trình duyệt tải / xem ảnh
#MINIO_APP_ACCESS_KEY=genie-app
#MINIO_APP_SECRET_KEY=changeme
# Vùng + tiền tố bucket: máy dev để trống (Silo). Production dùng AWS S3 — đặt trong deploy/.env, xem deploy/aws/README.md
#STORAGE_REGION=us-east-1
#STORAGE_BUCKET_PREFIX=
# Hai biến dưới chỉ dùng khi tự dựng Silo bằng docker compose (silo-init tạo tài khoản ứng dụng)
#MINIO_ROOT_USER=siloadmin
#MINIO_ROOT_PASSWORD=changeme

# ---------- Địa chỉ ----------
#SERVER_PORT=8080
#PUBLIC_WEB_URL=http://localhost:4321
#CORS_ALLOWED_ORIGINS=http://localhost:4321    # nhiều origin cách nhau dấu phẩy
#AI_WORKER_URL=http://localhost:8000

# ---------- Bảo mật (máy dev đã có mặc định — chỉ đặt khi muốn khác) ----------
#JWT_SECRET=<chuỗi ngẫu nhiên ≥ 32 ký tự>
#OTP_PEPPER=<chuỗi ngẫu nhiên>
#INTERNAL_TOKEN=local-internal-token           # phải TRÙNG với INTERNAL_TOKEN trong server-python/.env
#KYC_AES_KEY=<base64 32 byte>
#WALLET_HMAC_SECRET=<chuỗi ngẫu nhiên>
#AUTH_COOKIE_SECURE=false                      # true khi chạy HTTPS

# ---------- Email ----------
# Để trống = gửi vào Mailpit (xem OTP ở http://localhost:8025).
# Gửi Gmail thật: SMTP_PASSWORD là App Password 16 ký tự (Tài khoản Google → Bảo mật → Mật khẩu ứng dụng),
# KHÔNG phải mật khẩu đăng nhập Gmail; MAIL_FROM phải trùng SMTP_USER.
#SMTP_HOST=smtp.gmail.com
#SMTP_PORT=587
#SMTP_USER=
#SMTP_PASSWORD=
#SMTP_AUTH=true
#SMTP_STARTTLS=true
#MAIL_FROM=

# ---------- Đăng nhập mạng xã hội ----------
# Google (Google Cloud → Google Auth Platform → Clients; redirect URI http://localhost:4321/auth/oauth-callback)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Zalo (developers.zalo.me → ứng dụng → ID ứng dụng + Khóa bí mật; Callback URL http://localhost:4321/auth/oauth-callback)
ZALO_APP_ID=
ZALO_APP_SECRET=

# ---------- Tích hợp bên thứ ba (để trống = tính năng dùng bản giả lập / tắt) ----------
#VNPAY_TMN_CODE=
#VNPAY_HASH_SECRET=
#VNPAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
#VNPAY_RETURN_URL=http://localhost:4321/checkout/result
#SEPAY_API_KEY=
#SEPAY_ACCOUNT_NUMBER=
#GHN_TOKEN=
#GHN_SHOP_ID=
#GHTK_TOKEN=
#VTP_TOKEN=
#JT_KEY=
#GEMINI_API_KEY=

# ---------- Vận hành ----------
#LOG_LEVEL_GENIE=DEBUG            # mức log package com.genie
#LOG_LEVEL_ROOT=INFO
#GENIE_SCHEDULING_ENABLED=true    # false = tắt mọi cron
#BOOTSTRAP_ADMIN_EMAIL=admin@genie.local
#BOOTSTRAP_ADMIN_PASSWORD_HASH=   # Argon2id — sinh bằng: python3 scripts/hash-password.py '<mật khẩu>'
